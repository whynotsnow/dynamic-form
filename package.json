{
  "name": "@whynotsnow/dynamic-form-workspace",
  "version": "3.1.0",
  "private": true,
  "description": "DynamicForm 是一个基于 React 和 Ant Design 的动态表单组件，支持复杂的表单联动、自定义处理器、状态管理和性能优化。",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [
    "react",
    "antd",
    "form",
    "dynamic-form",
    "react-form",
    "ant-design",
    "form-engine",
    "dynamic",
    "dependency",
    "form-component",
    "动态表单",
    "表单引擎",
    "表单联动",
    "表单组件"
  ],
  "scripts": {
    "prepare": "husky install",
    "start": "vite",
    "site:start": "pnpm --filter @whynotsnow/dynamic-form-site start",
    "site:build": "pnpm --filter @whynotsnow/dynamic-form-site build",
    "build:all": "pnpm run type-check && pnpm run build && pnpm run site:build",
    "build": "pnpm --filter @whynotsnow/dynamic-form build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "release:publish": "node scripts/publish-dynamic-form.mjs",
    "lint": "eslint \"packages/dynamic-form/src/**/*.{ts,tsx,js,jsx}\" \"demos/**/*.{ts,tsx,js,jsx}\" --fix",
    "lint:check": "eslint \"packages/dynamic-form/src/**/*.{ts,tsx,js,jsx}\" \"demos/**/*.{ts,tsx,js,jsx}\"",
    "type-check": "pnpm --filter @whynotsnow/dynamic-form type-check && tsc --noEmit",
    "format": "prettier --write \"packages/dynamic-form/src/**/*.{ts,tsx,js,jsx}\" \"demos/**/*.{ts,tsx,js,jsx}\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whynotsnow/dynamic-form.git"
  },
  "author": {
    "name": "whynotsnow",
    "email": "whynotsnow@163.com",
    "url": "https://github.com/whynotsnow"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/whynotsnow/dynamic-form/issues"
  },
  "homepage": "https://github.com/whynotsnow/dynamic-form#readme",
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@ant-design/pro-components": "^2.8.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^5.0.1",
    "antd": "^5.27.1",
    "esbuild": "^0.25.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "form-chain-effect-engine": "^2.0.4",
    "husky": "^8.0.0",
    "lint-staged": "^16.1.5",
    "prettier": "3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
